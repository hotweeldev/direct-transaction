# ---------------------------------------------------------------------------
# direct-transaction - local environment sample
#
# Copy to .env and adjust:   Copy-Item .env.example .env
# .env is gitignored. NEVER commit real credentials.
#
# Spring Boot does NOT read .env files by itself. Load it with:
#   .\run-local.ps1         (PowerShell)
# or export the variables yourself before running the jar.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
# dev  -> Swagger on, DEBUG logging, raw exception messages
# prod -> Swagger off, sanitized error messages
SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=5244

# Directory for the rolling log files (system/ and http/ subfolders).
LOG_PATH=logs

# --- Oracle ----------------------------------------------------------------
# Quotes are required: the parentheses would otherwise be shell syntax.
ORACLE_URL='jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=FREE)))'
ORACLE_USER=DIRECT
ORACLE_PASSWORD='DIRECT123'

# --- Flyway ----------------------------------------------------------------
# false skips migration entirely - for pointing a local run at a database the pipeline
# owns. Leave true everywhere else; see db/README.md.
FLYWAY_ENABLED=true

# --- direct-integration (beneficiary name inquiry) --------------------------------
# false -> no outbound calls; the inquiry endpoint answers 503 with a readable message.
# Turn on only with a reachable direct-integration and a real key.
INTEGRATION_ENABLED=false
INTEGRATION_BASE_URL=http://localhost:5243
INTEGRATION_API_KEY=

# --- CORS ------------------------------------------------------------------
# Comma-separated HOSTS. No scheme, no port - an entry like https://host or host:5007
# matches nothing (see CorsConfigurationTest).
CORS_ALLOWED_ORIGINS=localhost
CORS_EXPOSED_HEADERS=X-Correlation-Id

# --- JDBC pool -------------------------------------------------------------
# Pod-level, not cluster-level: 10 pods at 50 connections each is 500 sessions against
# Oracle, which is usually well past what the DBA allocated. Size it against
# processes/sessions on the instance, not against traffic.
DB_POOL_MIN_IDLE=0
DB_POOL_MAX_SIZE=10
# Fail fast when the pool is exhausted rather than queueing requests behind it.
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=600000
# Keep below any firewall idle timeout or Oracle profile IDLE_TIME, or the pool serves
# connections the network already dropped.
DB_POOL_MAX_LIFETIME_MS=1800000

# --- UMAS authenticator (OTP) ----------------------------------------------
AUTHENTICATOR_BASE_URL=http://localhost:8085
AUTHENTICATOR_TENANT_ID=default
AUTHENTICATOR_MAV_API_KEY=
